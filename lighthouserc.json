{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/index.html", "http://localhost/fil/index.html"],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["canonical", "is-on-https", "redirects-http"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "errors-in-console": ["error", { "maxLength": 0 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 0 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 153600 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
