---
import '../styles/global.css';
import interTight from '@fontsource/inter-tight/files/inter-tight-latin-800-normal.woff2?url';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteNotice from '../components/SiteNotice.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  lang?: Lang;
  description?: string;
  /** Set on pages search engines must not index (for example the 404 page). */
  noindex?: boolean;
  /**
   * `prose` (default) puts the page in a centred reading column. `full` lets
   * the page's own sections run edge to edge, as the White Portal home does.
   */
  width?: 'prose' | 'full';
  /** Link-preview tags. Only guide pages pass them, so other pages get none. */
  og?: { title: string; description: string; url: string };
}

const { title, lang = 'en', description, noindex = false, width = 'prose', og } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#00226e" />
    <title>{title} · {t(lang, 'site.name')}</title>
    {description && <meta name="description" content={description} />}
    {og && <meta property="og:title" content={og.title} />}
    {og && <meta property="og:description" content={og.description} />}
    {og && <meta property="og:url" content={og.url} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Start the display font with the stylesheet, so headings do not reflow when it arrives. -->
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-sun focus:px-4 focus:py-2.5 focus:font-bold focus:text-ink"
    >
      {t(lang, 'site.skip')}
    </a>
    <SiteNotice lang={lang} />
    <SiteHeader lang={lang} />
    <slot name="below-header" />
    <main
      id="main"
      tabindex="-1"
      class:list={[
        'flex-1 outline-none',
        width === 'prose' && 'mx-auto w-full max-w-2xl px-4 py-6',
      ]}
    >
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
