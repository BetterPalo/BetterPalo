---
import Base from '../../layouts/Base.astro';
import { listServices, type Service } from '../../lib/data';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const services = await listServices();
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<Base title={service.name} description={service.description}>
  <h1 class="text-2xl font-bold">{service.name}</h1>
  <p class="mt-2">{service.office ?? t('en', 'missing.stated')}</p>
  <p class="mt-4">{service.description}</p>
</Base>
