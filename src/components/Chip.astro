---
// Square shortcut chip, e.g. "Popular:" search links (DESIGN.md "Chips").
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="inline-flex min-h-8 items-center bg-chip-bg px-2.5 py-1 text-sm font-semibold text-chip-fg no-underline transition-colors duration-160 ease-out hover:bg-accent hover:text-on-accent"
>
  <slot />
</a>
