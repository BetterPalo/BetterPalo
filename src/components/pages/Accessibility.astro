---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import IconWell from '../home/IconWell.astro';
import { t, type Lang } from '../../i18n/ui';
import { BUG_REPORT_URL } from '../../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const features = [
  { icon: 'right', key: 'skip' },
  { icon: 'flag', key: 'contrast' },
  { icon: 'grid', key: 'keyboard' },
  { icon: 'pulse', key: 'motion' },
  { icon: 'globe', key: 'lang' },
  { icon: 'print', key: 'print' },
] as const;
---

<Base
  title={t(lang, 'accessibility.title')}
  lang={lang}
  description={t(lang, 'accessibility.lead')}
  width="full"
>
  <PageHero
    id="accessibility-title"
    eyebrow={t(lang, 'accessibility.eyebrow')}
    title={t(lang, 'accessibility.title')}
    lead={t(lang, 'accessibility.lead')}
  />

  <section class="border-y border-edge bg-canvas-alt py-section">
    <div class="wrap max-w-3xl">
      <SectionHead
        id="accessibility-standardtitle"
        title={t(lang, 'accessibility.standardTitle')}
        highlight=""
      />
      <p class="mt-3 text-fg-soft">{t(lang, 'accessibility.standardBody')}</p>
      <ul class="mt-4 list-disc pl-5 text-sm text-fg-soft">
        <li>{t(lang, 'accessibility.standard.li1')}</li>
        <li>{t(lang, 'accessibility.standard.li2')}</li>
        <li>{t(lang, 'accessibility.standard.li3')}</li>
      </ul>
    </div>
  </section>

  <section class="wrap py-section">
    <SectionHead
      id="accessibility-featurestitle"
      title={t(lang, 'accessibility.featuresTitle')}
      highlight=""
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {features.map(({ icon, key }) => (
        <article class="flex gap-4 border border-edge bg-surface p-6">
          <IconWell name={icon} />
          <div>
            <h3 class="font-display text-lg">{t(lang, `accessibility.feature.${key}.title`)}</h3>
            <p class="mt-1 text-sm text-fg-soft">{t(lang, `accessibility.feature.${key}.body`)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-edge bg-canvas-alt py-section">
    <div class="wrap max-w-2xl">
      <SectionHead
        id="accessibility-feedbacktitle"
        title={t(lang, 'accessibility.feedbackTitle')}
        highlight=""
      />
      <p class="mt-3 text-fg-soft">{t(lang, 'accessibility.feedbackBody')}</p>
      <p class="mt-4">
        <a href={BUG_REPORT_URL} rel="external" class="font-bold text-accent underline">
          {t(lang, 'accessibility.feedbackCta')} →
        </a>
      </p>
    </div>
  </section>
</Base>
