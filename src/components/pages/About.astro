---
import Base from '../../layouts/Base.astro';
import SectionHead from '../SectionHead.astro';
import IconWell from '../home/IconWell.astro';
import { t, type Lang } from '../../i18n/ui';
import { census, charter, formatNumber } from '../../lib/site-facts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const stats = [
  {
    icon: 'users',
    num: formatNumber(census.population),
    label: t(lang, 'about.stat.pop'),
    src: t(lang, 'about.stat.pop.src'),
  },
  {
    icon: 'pin',
    num: String(census.barangays),
    label: t(lang, 'about.stat.brgy'),
    src: t(lang, 'about.stat.brgy.src'),
  },
  {
    icon: 'doc',
    num: String(charter.services),
    label: t(lang, 'about.stat.services'),
    src: t(lang, 'about.stat.services.src'),
  },
  {
    icon: 'building',
    num: String(charter.offices),
    label: t(lang, 'about.stat.offices'),
    src: t(lang, 'about.stat.offices.src'),
  },
] as const;
---

<Base title={t(lang, 'about.title')} lang={lang} description={t(lang, 'about.lead')} width="full">
  <section class="py-section" aria-labelledby="about-title">
    <div class="wrap">
      <p class="mb-5 text-[0.8125rem] font-bold tracking-label text-accent uppercase">
        {t(lang, 'about.eyebrow')}
      </p>
      <h1
        id="about-title"
        class="text-[clamp(2.5rem,6.2vw,5.25rem)] leading-[0.95] tracking-display"
      >
        {t(lang, 'about.title')}
      </h1>
      <p class="mt-6 max-w-xl text-[clamp(1.05rem,1.5vw,1.3rem)] text-fg-soft">
        {t(lang, 'about.lead')}
      </p>
    </div>
  </section>

  <section class="inv py-section" aria-labelledby="facts-title">
    <div class="wrap">
      <SectionHead id="facts-title" title={t(lang, 'about.factsTitle')} highlight="" />
      <div class="grid gap-4 min-[40rem]:grid-cols-2 min-[72rem]:grid-cols-4 min-[72rem]:gap-5">
        {stats.map((stat) => (
          <div class="flex gap-4 border border-edge bg-surface p-6">
            <IconWell name={stat.icon} />
            <div class="min-w-0">
              <span class="block font-display text-[clamp(2.2rem,3.4vw,2.9rem)] leading-none font-extrabold tracking-display text-accent tabular-nums">
                {stat.num}
              </span>
              <span class="mt-1.5 block font-bold">{stat.label}</span>
              <span class="mt-0.5 block text-[0.8125rem] text-fg-soft">{stat.src}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-section" aria-labelledby="barangays-title">
    <div class="wrap max-w-3xl">
      <SectionHead id="barangays-title" title={t(lang, 'about.barangaysTitle')} highlight="" />
      <p class="text-fg-soft">{t(lang, 'about.barangaysBody')}</p>
    </div>
  </section>

  <section class="border-t border-edge bg-canvas-alt py-section">
    <div class="wrap max-w-3xl">
      <SectionHead id="sources-title" title={t(lang, 'about.sourcesTitle')} highlight="" />
      <p class="text-fg-soft">{t(lang, 'about.sourcesBody')}</p>
      <ul class="mt-4 list-disc pl-5 text-sm text-fg-soft">
        <li>{t(lang, 'about.sources.li1')}</li>
        <li>{t(lang, 'about.sources.li2')}</li>
      </ul>
    </div>
  </section>
</Base>
