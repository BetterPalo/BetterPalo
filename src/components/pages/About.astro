---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import IconWell from '../home/IconWell.astro';
import SourceNote from '../SourceNote.astro';
import NotStated from '../guide/NotStated.astro';
import { t, type Lang } from '../../i18n/ui';
import { census, charter, formatNumber } from '../../lib/site-facts';
import { listBarangays } from '../../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dataLang = lang === 'en' ? undefined : 'en';
const barangays = await listBarangays();
// One source note per distinct source; the verified barangays share one PSA table.
const sources = [...new Map(barangays.map((b) => [b.source, b])).values()];

const stats = [
  {
    icon: 'users',
    num: formatNumber(census.population),
    label: t(lang, 'about.stat.pop'),
    src: t(lang, 'about.stat.pop.src'),
  },
  {
    icon: 'pin',
    num: String(census.barangays),
    label: t(lang, 'about.stat.brgy'),
    src: t(lang, 'about.stat.brgy.src'),
  },
  {
    icon: 'doc',
    num: String(charter.services),
    label: t(lang, 'about.stat.services'),
    src: t(lang, 'about.stat.services.src'),
  },
  {
    icon: 'building',
    num: String(charter.offices),
    label: t(lang, 'about.stat.offices'),
    src: t(lang, 'about.stat.offices.src'),
  },
] as const;
---

<Base title={t(lang, 'about.title')} lang={lang} description={t(lang, 'about.lead')} width="full">
  <PageHero
    id="about-title"
    eyebrow={t(lang, 'about.eyebrow')}
    title={t(lang, 'about.title')}
    lead={t(lang, 'about.lead')}
  />

  <section class="inv py-section" aria-labelledby="facts-title">
    <div class="wrap">
      <SectionHead id="facts-title" title={t(lang, 'about.factsTitle')} highlight="" />
      <div class="grid gap-4 min-[40rem]:grid-cols-2 min-[72rem]:grid-cols-4 min-[72rem]:gap-5">
        {stats.map((stat) => (
          <div class="flex gap-4 border border-edge bg-surface p-6">
            <IconWell name={stat.icon} />
            <div class="min-w-0">
              <span class="block font-display text-[clamp(2.2rem,3.4vw,2.9rem)] leading-none font-extrabold tracking-display text-accent tabular-nums">
                {stat.num}
              </span>
              <span class="mt-1.5 block font-bold">{stat.label}</span>
              <span class="mt-0.5 block text-[0.8125rem] text-fg-soft">{stat.src}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-section" aria-labelledby="barangays-title">
    <div class="wrap max-w-3xl">
      <SectionHead id="barangays-title" title={t(lang, 'about.barangaysTitle')} highlight="" />
      {barangays.length === 0 ? (
        <p id="barangays-pending" class="text-fg-soft">
          {t(lang, 'about.barangaysBody')}
        </p>
      ) : (
        <>
          {barangays.length < census.barangays && (
            <p id="barangays-partial" class="text-fg-soft">
              {t(lang, 'about.brgy.partial')}
            </p>
          )}
          <div class="overflow-x-auto">
            <table id="barangays" class="mt-4 w-full text-sm">
              <thead>
                <tr>
                  <th scope="col" class="border-b border-edge py-2 text-left">
                    {t(lang, 'about.brgy.name')}
                  </th>
                  <th scope="col" class="border-b border-edge py-2 text-left">
                    {t(lang, 'about.brgy.population')}
                  </th>
                  <th scope="col" class="border-b border-edge py-2 text-left">
                    {t(lang, 'about.brgy.censusYear')}
                  </th>
                </tr>
              </thead>
              <tbody>
                {barangays.map((b) => (
                  <tr>
                    <td class="border-b border-edge py-2" lang={dataLang}>
                      {b.name}
                    </td>
                    <td class="border-b border-edge py-2 tabular-nums">
                      {b.population !== null && b.census_year !== null ? (
                        formatNumber(b.population)
                      ) : (
                        <NotStated lang={lang} />
                      )}
                    </td>
                    <td class="border-b border-edge py-2 tabular-nums">{b.census_year ?? ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {sources.map((b) => (
            <SourceNote
              lang={lang}
              source={b.source!}
              pages={b.source_pages}
              lastVerified={b.last_verified!}
            />
          ))}
        </>
      )}
    </div>
  </section>

  <section class="border-t border-edge bg-canvas-alt py-section">
    <div class="wrap max-w-3xl">
      <SectionHead id="sources-title" title={t(lang, 'about.sourcesTitle')} highlight="" />
      <p class="text-fg-soft">{t(lang, 'about.sourcesBody')}</p>
      <ul class="mt-4 list-disc pl-5 text-sm text-fg-soft">
        <li>{t(lang, 'about.sources.li1')}</li>
        <li>{t(lang, 'about.sources.li2')}</li>
      </ul>
    </div>
  </section>
</Base>
