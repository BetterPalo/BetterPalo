---
import Base from '../../layouts/Base.astro';
import { listServices } from '../../lib/data';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const services = await listServices();
---

<Base
  title={t(lang, 'servicesDir.title')}
  lang={lang}
  description={t(lang, 'servicesDir.lead')}
  width="full"
>
  <section class="wrap py-section">
    <p class="text-sm font-bold tracking-label text-flag uppercase">
      {t(lang, 'servicesDir.eyebrow')}
    </p>
    <h1 class="mt-3 font-display text-4xl tracking-headline sm:text-5xl">
      {t(lang, 'servicesDir.title')}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-fg-soft">{t(lang, 'servicesDir.lead')}</p>
  </section>

  <section class="wrap pb-section">
    {services.length === 0 ? (
      <div class="border border-edge bg-canvas-alt p-8 text-center">
        <p class="font-display text-xl">{t(lang, 'servicesDir.empty')}</p>
        <p class="mt-2 text-sm text-fg-soft">{t(lang, 'servicesDir.emptyBody')}</p>
      </div>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2">
        {services.map((service) => (
          <li>
            <a
              href={`/services/${service.id}/`}
              class="block border border-edge bg-canvas p-4 no-underline hover:border-flag"
            >
              <b class="font-display tracking-title">{service.name}</b>
              <p class="mt-1 text-sm text-fg-soft">{service.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
