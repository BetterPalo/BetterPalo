---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import { listServices } from '../../lib/data';
import { t, type Lang } from '../../i18n/ui';
import { localizedPath } from '../../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const services = await listServices();
---

<Base
  title={t(lang, 'servicesDir.title')}
  lang={lang}
  description={t(lang, 'servicesDir.lead')}
  width="full"
>
  <PageHero
    id="services-title"
    eyebrow={t(lang, 'servicesDir.eyebrow')}
    title={t(lang, 'servicesDir.title')}
    lead={t(lang, 'servicesDir.lead')}
  />

  <section class="wrap pb-section">
    {services.length === 0 ? (
      <div class="border border-edge bg-surface p-8 text-center">
        <p class="font-display text-xl">{t(lang, 'servicesDir.empty')}</p>
        <p class="mt-2 text-sm text-fg-soft">{t(lang, 'servicesDir.emptyBody')}</p>
      </div>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2">
        {services.map((service) => (
          <li>
            <a
              href={localizedPath(lang, `/services/${service.id}/`)}
              class="block border border-edge bg-canvas p-4 no-underline hover:border-accent"
            >
              <b class="font-display tracking-title">{service.name}</b>
              <p class="mt-1 text-sm text-fg-soft">{service.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
