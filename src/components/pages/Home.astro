---
// Home page for both languages: the White Portal landing page (DESIGN.md).
// Facts come from src/lib/site-facts.ts. Shortcut chips and the sample-sheet
// button come from published guides, so they stay hidden until there are some.
import Base from '../../layouts/Base.astro';
import Glance from '../home/Glance.astro';
import GetInTouch from '../home/GetInTouch.astro';
import Hero from '../home/Hero.astro';
import HowItsMade from '../home/HowItsMade.astro';
import OfficesSection from '../home/OfficesSection.astro';
import PopularServices from '../home/PopularServices.astro';
import SheetFeature from '../home/SheetFeature.astro';
import Sources from '../home/Sources.astro';
import Volunteer from '../home/Volunteer.astro';
import { t, type Lang } from '../../i18n/ui';
import { listServices } from '../../lib/data';
import { localizedPath } from '../../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const services = await listServices();
const popular = services.slice(0, 3).map((service) => ({
  href: localizedPath(lang, `/services/${service.id}/`),
  label: service.name,
}));
const sampleHref = popular[0]?.href;
---

<Base title={t(lang, 'home.title')} lang={lang} description={t(lang, 'home.lead')} width="full">
  <Hero lang={lang} popular={popular} />
  <SheetFeature lang={lang} sampleHref={sampleHref} />
  <PopularServices lang={lang} />
  <Glance lang={lang} />
  <OfficesSection lang={lang} />
  <HowItsMade lang={lang} />
  <Sources lang={lang} />
  <GetInTouch lang={lang} />
  <Volunteer lang={lang} />
</Base>
