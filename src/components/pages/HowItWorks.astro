---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import IconWell from '../home/IconWell.astro';
import { t, type Lang } from '../../i18n/ui';
import { REPO_URL } from '../../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const steps = [
  [
    t(lang, 'howItWorks.step.1'),
    t(lang, 'howItWorks.step.1.title'),
    t(lang, 'howItWorks.step.1.body'),
  ],
  [
    t(lang, 'howItWorks.step.2'),
    t(lang, 'howItWorks.step.2.title'),
    t(lang, 'howItWorks.step.2.body'),
  ],
  [
    t(lang, 'howItWorks.step.3'),
    t(lang, 'howItWorks.step.3.title'),
    t(lang, 'howItWorks.step.3.body'),
  ],
  [
    t(lang, 'howItWorks.step.4'),
    t(lang, 'howItWorks.step.4.title'),
    t(lang, 'howItWorks.step.4.body'),
  ],
];

const principles = [
  { icon: 'check', key: 'accuracy' },
  { icon: 'doc', key: 'source' },
  { icon: 'book', key: 'plain' },
  { icon: 'globe', key: 'open' },
] as const;
---

<Base
  title={t(lang, 'howItWorks.title')}
  lang={lang}
  description={t(lang, 'howItWorks.lead')}
  width="full"
>
  <PageHero
    id="how-it-works-title"
    eyebrow={t(lang, 'howItWorks.eyebrow')}
    title={t(lang, 'howItWorks.title')}
    lead={t(lang, 'howItWorks.lead')}
  />

  <section class="border-y border-edge bg-canvas-alt py-section">
    <div class="wrap">
      <SectionHead
        id="howitworks-stepstitle"
        title={t(lang, 'howItWorks.stepsTitle')}
        highlight=""
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map(([step, title, body]) => (
          <article class="border border-edge bg-surface p-6">
            <b class="text-xs font-bold tracking-label text-accent uppercase">{step}</b>
            <h3 class="mt-2 font-display text-lg">{title}</h3>
            <p class="mt-1 text-sm text-fg-soft">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap py-section">
    <SectionHead
      id="howitworks-principlestitle"
      title={t(lang, 'howItWorks.principlesTitle')}
      highlight=""
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {principles.map(({ icon, key }) => (
        <article class="flex gap-4 border border-edge bg-surface p-6">
          <IconWell name={icon} />
          <div>
            <h3 class="font-display text-lg">{t(lang, `howItWorks.principle.${key}.title`)}</h3>
            <p class="mt-1 text-sm text-fg-soft">{t(lang, `howItWorks.principle.${key}.body`)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-edge bg-canvas-alt py-section">
    <div class="wrap max-w-2xl">
      <SectionHead
        id="howitworks-volunteertitle"
        title={t(lang, 'howItWorks.volunteerTitle')}
        highlight=""
      />
      <p class="mt-3 text-fg-soft">{t(lang, 'howItWorks.volunteerBody')}</p>
      <p class="mt-4">
        <a href={REPO_URL} rel="external" class="font-bold text-accent underline">
          {t(lang, 'howItWorks.volunteerCta')} →
        </a>
      </p>
    </div>
  </section>
</Base>
