---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import SpotCard from '../tourism/SpotCard.astro';
import TourismFilters from '../tourism/TourismFilters.astro';
import { listSpots } from '../../lib/data';
import { isVerifiedSpot } from '../../lib/publishing';
import { categoriesInUse, tourismGroupsInUse } from '../../lib/schemas/tourism';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const spots = await listSpots();
const unverified = spots.filter((spot) => !isVerifiedSpot(spot)).length;
const categories = categoriesInUse(spots);
const groups = tourismGroupsInUse(spots);
---

<Base
  title={t(lang, 'tourism.title')}
  lang={lang}
  description={t(lang, 'tourism.lead')}
  width="full"
>
  <PageHero
    id="tourism-title"
    eyebrow={t(lang, 'tourism.eyebrow')}
    title={t(lang, 'tourism.title')}
    lead={t(lang, 'tourism.lead')}
  />

  <section class="inv py-section" aria-labelledby="spots-title">
    <div class="wrap">
      <SectionHead
        id="spots-title"
        title={t(lang, 'tourism.spotsTitle')}
        highlight={t(lang, 'tourism.spotsHighlight')}
        sub={t(lang, 'tourism.spotsSub')}
      />

      {spots.length === 0 ? (
        <div class="border border-edge bg-surface p-8 text-center">
          <p class="font-display text-xl">{t(lang, 'tourism.empty')}</p>
          <p class="mt-2 text-sm text-fg-soft">{t(lang, 'tourism.emptyBody')}</p>
        </div>
      ) : (
        <>
          <div class="mb-6 border border-edge bg-surface p-4 min-[40rem]:p-5">
            <TourismFilters lang={lang} categories={categories} groups={groups} />
            <p class="mt-4 text-sm text-fg-soft" role="status">
              {t(lang, 'tourism.filters.shown')} <span data-spot-count>{spots.length}</span>
            </p>
            <noscript>
              <p class="mt-2 text-sm text-fg-soft">{t(lang, 'tourism.filters.noScript')}</p>
            </noscript>
          </div>

          <p
            class="mb-6 border border-edge bg-surface p-6 text-center text-sm text-fg-soft"
            data-spot-empty
            hidden
          >
            {t(lang, 'tourism.filters.none')}
          </p>

          <ul class="grid gap-5 min-[40rem]:grid-cols-2 min-[72rem]:grid-cols-3" data-spot-list>
            {spots.map((spot) => (
              <SpotCard spot={spot} lang={lang} />
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  <section class="border-t border-edge bg-canvas-alt py-section">
    <div class="wrap max-w-3xl">
      <SectionHead id="note-title" title={t(lang, 'tourism.noteTitle')} highlight="" />
      <p class="text-fg-soft">{t(lang, 'tourism.noteBody')}</p>
      {unverified > 0 && (
        <p class="mt-3 text-sm text-fg-soft">{t(lang, 'tourism.unverifiedNote')}</p>
      )}
    </div>
  </section>
</Base>

<script>
  // Filter the spot cards by visitor group and place type. The page lists every
  // spot without this script; with JavaScript off the chip rows are hidden by
  // CSS and the whole list stays readable.
  const shell = document.querySelector<HTMLElement>('[data-tourism-filters]');
  const list = document.querySelector<HTMLElement>('[data-spot-list]');
  const count = document.querySelector<HTMLElement>('[data-spot-count]');
  const empty = document.querySelector<HTMLElement>('[data-spot-empty]');

  if (shell && list) {
    const cards = [...list.querySelectorAll<HTMLElement>('[data-spot]')];
    const groupButtons = [...shell.querySelectorAll<HTMLButtonElement>('[data-filter-group]')];
    const typeButtons = [...shell.querySelectorAll<HTMLButtonElement>('[data-filter-type]')];

    let group = 'all';
    let type = 'all';

    const groupOfType = (value: string) =>
      typeButtons.find((button) => button.dataset.filterType === value)?.dataset.group;

    const render = () => {
      for (const button of groupButtons) {
        const pressed = (button.dataset.filterGroup ?? 'all') === group;
        button.setAttribute('aria-pressed', String(pressed));
      }

      for (const button of typeButtons) {
        const owns = button.dataset.group;
        button.setAttribute('aria-pressed', String((button.dataset.filterType ?? 'all') === type));
        // A type belongs to one group, so hide the chips from other groups.
        button.hidden = group !== 'all' && owns !== undefined && owns !== group;
      }

      let shown = 0;
      for (const card of cards) {
        const categories = (card.dataset.categories ?? '').split(' ');
        const match =
          (group === 'all' || card.dataset.group === group) &&
          (type === 'all' || categories.includes(type));
        card.hidden = !match;
        if (match) shown += 1;
      }

      if (count) count.textContent = String(shown);
      if (empty) empty.hidden = shown > 0;
    };

    const writeHash = () => {
      const next = type !== 'all' ? type : group !== 'all' ? group : '';
      history.replaceState(null, '', next ? `#${next}` : `${location.pathname}${location.search}`);
    };

    const readHash = () => {
      const wanted = location.hash.replace(/^#/, '');
      if (wanted && groupOfType(wanted) !== undefined) {
        type = wanted;
        group = groupOfType(wanted) ?? 'all';
      } else if (wanted && groupButtons.some((button) => button.dataset.filterGroup === wanted)) {
        group = wanted;
        type = 'all';
      } else {
        group = 'all';
        type = 'all';
      }
      render();
    };

    for (const button of groupButtons) {
      button.addEventListener('click', () => {
        group = button.dataset.filterGroup ?? 'all';
        // A type only makes sense inside its own group; the group's "all" resets it.
        if (group === 'all' || (type !== 'all' && groupOfType(type) !== group)) type = 'all';
        render();
        writeHash();
      });
    }

    for (const button of typeButtons) {
      button.addEventListener('click', () => {
        type = button.dataset.filterType ?? 'all';
        if (type !== 'all') group = button.dataset.group ?? 'all';
        render();
        writeHash();
      });
    }

    window.addEventListener('hashchange', readHash);
    readHash();
  }
</script>
