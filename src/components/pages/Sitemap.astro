---
import Base from '../../layouts/Base.astro';
import { languages, t, type Lang } from '../../i18n/ui';
import { listServices } from '../../lib/data';
import {
  areaOf,
  filVariantOf,
  labelFor,
  listEnglishPaths,
  type Area,
  type PageLabel,
} from '../../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** The same page in the other language, when that page file exists. */
interface Alternate {
  path: string;
  lang: Lang;
  name: string;
}

/** One line of the sitemap, written for the language being read. */
interface Entry {
  /** URL in this language, falling back to English while it is untranslated. */
  path: string;
  alternate: Alternate | null;
  label: PageLabel;
  /** A quiet second line, such as the office a service guide belongs to. */
  detail?: string;
}

const areas: Area[] = ['services', 'offices', 'about', 'site'];
const services = await listServices();

/** One line of the sitemap, in this language, for a page published in English. */
function toEntry(enPath: string, label: PageLabel, detail?: string): Entry {
  const fil = filVariantOf(enPath);
  if (lang === 'en') {
    return {
      path: enPath,
      alternate: fil ? { path: fil, lang: 'fil', name: languages.fil } : null,
      label,
      detail,
    };
  }
  return {
    path: fil ?? enPath,
    alternate: fil ? { path: enPath, lang: 'en', name: languages.en } : null,
    // An English label, or an English-only page, is pending translation here.
    label: { ...label, pending: label.pending || fil === null },
    detail,
  };
}

const entries: Record<Area, Entry[]> = { services: [], offices: [], about: [], site: [] };

// Static English pages come from the page files; the content collection below
// lists the service guides, which are the pages that actually get built for it.
for (const route of listEnglishPaths()) {
  entries[areaOf(route)].push(toEntry(route, labelFor(lang, route)));
}
for (const service of services) {
  entries.services.push(
    toEntry(
      `/services/${service.id}/`,
      { text: service.name, pending: false },
      service.office ?? t(lang, 'missing.stated'),
    ),
  );
}

const otherLang: Lang = lang === 'en' ? 'fil' : 'en';
const switchPath = (lang === 'en' ? filVariantOf('/sitemap/') : '/sitemap/') ?? '/sitemap/';
---

<Base title={t(lang, 'sitemap.title')} lang={lang} description={t(lang, 'sitemap.lead')}>
  <h1 class="text-3xl tracking-headline">{t(lang, 'sitemap.title')}</h1>
  <p class="mt-2 text-fg-soft">{t(lang, 'sitemap.lead')}</p>

  <p class="mt-3 text-sm text-fg-soft">
    {t(lang, 'sitemap.lang')}
    <a
      href={switchPath}
      hreflang={otherLang}
      lang={otherLang}
      class="ml-1 underline underline-offset-2"
    >
      {languages[otherLang]}
    </a>
  </p>

  {areas.map((area) => (
    <section class="mt-8" aria-labelledby={`area-${area}`}>
      <h2
        id={`area-${area}`}
        class="border-b border-edge pb-2 text-xs font-semibold tracking-label text-fg-soft uppercase"
      >
        {t(lang, `sitemap.area.${area}` as Parameters<typeof t>[1])}
      </h2>
      {entries[area].length === 0 ? (
        <p class="mt-3 text-sm text-fg-soft">{t(lang, 'sitemap.empty')}</p>
      ) : (
        <ul class="divide-y divide-edge">
          {entries[area].map((entry) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
              <div class="min-w-0">
                <a href={entry.path} class="underline underline-offset-2">
                  {entry.label.text}
                </a>
                {entry.label.pending && (
                  <span class="ml-2 text-xs text-fg-soft">{t(lang, 'sitemap.pending')}</span>
                )}
                {entry.detail && <span class="block text-sm text-fg-soft">{entry.detail}</span>}
              </div>
              {entry.alternate && (
                <a
                  href={entry.alternate.path}
                  hreflang={entry.alternate.lang}
                  lang={entry.alternate.lang}
                  class="shrink-0 text-xs font-medium text-fg-soft underline underline-offset-2"
                >
                  {entry.alternate.name}
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}

  <p class="mt-8 border-t border-edge pt-4 text-sm">
    <a href="/sitemap-index.xml" class="underline underline-offset-2">
      {t(lang, 'sitemap.xml')}
    </a>
  </p>
</Base>
