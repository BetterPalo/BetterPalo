---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import IconWell from '../home/IconWell.astro';
import { t, type Lang } from '../../i18n/ui';
import { CONTRIBUTING_URL } from '../../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const ways = [
  { icon: 'doc', key: 'data' },
  { icon: 'globe', key: 'translation' },
  { icon: 'grid', key: 'design' },
  { icon: 'code', key: 'code' },
] as const;
---

<Base
  title={t(lang, 'contribute.title')}
  lang={lang}
  description={t(lang, 'contribute.lead')}
  width="full"
>
  <PageHero
    id="contribute-title"
    eyebrow={t(lang, 'contribute.eyebrow')}
    title={t(lang, 'contribute.title')}
    lead={t(lang, 'contribute.lead')}
  />

  <section class="border-y border-edge bg-canvas-alt py-section">
    <div class="wrap">
      <SectionHead id="contribute-waystitle" title={t(lang, 'contribute.waysTitle')} highlight="" />
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {ways.map(({ icon, key }) => (
          <article class="flex gap-4 border border-edge bg-surface p-6">
            <IconWell name={icon} />
            <div>
              <h3 class="font-display text-lg">{t(lang, `contribute.way.${key}.title`)}</h3>
              <p class="mt-1 text-sm text-fg-soft">{t(lang, `contribute.way.${key}.body`)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap py-section">
    <SectionHead id="contribute-datatitle" title={t(lang, 'contribute.dataTitle')} highlight="" />
    <p class="mt-3 max-w-2xl text-fg-soft">{t(lang, 'contribute.dataBody')}</p>
    <ul class="mt-4 list-disc pl-5 text-sm text-fg-soft">
      <li>{t(lang, 'contribute.data.li1')}</li>
      <li>{t(lang, 'contribute.data.li2')}</li>
      <li>{t(lang, 'contribute.data.li3')}</li>
    </ul>
    <p class="mt-6">
      <a href={CONTRIBUTING_URL} rel="external" class="font-bold text-accent underline">
        {t(lang, 'contribute.data.cta')} →
      </a>
    </p>
  </section>

  <section class="border-t border-edge bg-canvas-alt py-section">
    <div class="wrap max-w-2xl">
      <SectionHead
        id="contribute-workflowtitle"
        title={t(lang, 'contribute.workflowTitle')}
        highlight=""
      />
      <p class="mt-3 text-fg-soft">{t(lang, 'contribute.workflowBody')}</p>
      <ol class="mt-4 list-decimal pl-5 text-sm text-fg-soft">
        <li>{t(lang, 'contribute.workflow.1')}</li>
        <li>{t(lang, 'contribute.workflow.2')}</li>
        <li>{t(lang, 'contribute.workflow.3')}</li>
        <li>{t(lang, 'contribute.workflow.4')}</li>
      </ol>
    </div>
  </section>
</Base>
