---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base title={t(lang, 'contribute.title')} lang={lang} description={t(lang, 'contribute.lead')}>
  <section class="page-width py-section">
    <p class="text-sm font-bold tracking-label text-flag uppercase">
      {t(lang, 'contribute.eyebrow')}
    </p>
    <h1 class="mt-3 font-display text-4xl tracking-headline sm:text-5xl">
      {t(lang, 'contribute.title')}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-fg-soft">{t(lang, 'contribute.lead')}</p>
  </section>

  <section class="border-y border-edge bg-canvas-alt py-section">
    <div class="page-width">
      <h2 class="font-display text-3xl tracking-headline">{t(lang, 'contribute.waysTitle')}</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {[
          [t(lang, 'contribute.way.data.title'), t(lang, 'contribute.way.data.body')],
          [t(lang, 'contribute.way.translation.title'), t(lang, 'contribute.way.translation.body')],
          [t(lang, 'contribute.way.design.title'), t(lang, 'contribute.way.design.body')],
          [t(lang, 'contribute.way.code.title'), t(lang, 'contribute.way.code.body')],
        ].map(([title, body]) => (
          <article class="border border-edge bg-canvas p-5">
            <h3 class="font-display text-lg">{title}</h3>
            <p class="mt-1 text-sm text-fg-soft">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-width py-section">
    <h2 class="font-display text-3xl tracking-headline">{t(lang, 'contribute.dataTitle')}</h2>
    <p class="mt-3 max-w-2xl text-fg-soft">{t(lang, 'contribute.dataBody')}</p>
    <ul class="mt-4 list-disc pl-5 text-sm text-fg-soft">
      <li>{t(lang, 'contribute.data.li1')}</li>
      <li>{t(lang, 'contribute.data.li2')}</li>
      <li>{t(lang, 'contribute.data.li3')}</li>
    </ul>
    <p class="mt-6">
      <a
        href="https://github.com/BetterPalo/BetterPalo"
        rel="external"
        class="font-semibold text-flag underline"
      >
        {t(lang, 'contribute.data.cta')} →
      </a>
    </p>
  </section>

  <section class="border-t border-edge bg-canvas-alt py-section">
    <div class="page-width max-w-2xl">
      <h2 class="font-display text-3xl tracking-headline">{t(lang, 'contribute.workflowTitle')}</h2>
      <p class="mt-3 text-fg-soft">{t(lang, 'contribute.workflowBody')}</p>
      <ol class="mt-4 list-decimal pl-5 text-sm text-fg-soft">
        <li>{t(lang, 'contribute.workflow.1')}</li>
        <li>{t(lang, 'contribute.workflow.2')}</li>
        <li>{t(lang, 'contribute.workflow.3')}</li>
        <li>{t(lang, 'contribute.workflow.4')}</li>
      </ol>
    </div>
  </section>
</Base>
