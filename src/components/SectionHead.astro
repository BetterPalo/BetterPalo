---
// Two-tone section heading with an optional lead and "more" link, from the
// White Portal `.p-head`. End the highlight with a period (DESIGN.md).
import Icon from './Icon.astro';
import { routeExists } from '../lib/routes';

interface Props {
  /** id for the heading, so the section can use aria-labelledby. */
  id: string;
  /** First, plain part of the heading. */
  title: string;
  /** Second part, in the accent colour. */
  highlight: string;
  sub?: string;
  /** Rendered only when `href` is an external link or a page that exists. */
  more?: { href: string; label: string };
}

const { id, title, highlight, sub, more } = Astro.props;
const showMore = more !== undefined && (/^https?:/.test(more.href) || routeExists(more.href));
---

<div class="mb-[clamp(1.75rem,3.5vw,2.5rem)] flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
  <div>
    <h2 id={id} class="text-[clamp(2rem,4.6vw,3.75rem)] leading-[0.98] tracking-display">
      {title} <span class="text-accent">{highlight}</span>
    </h2>
    {sub && <p class="mt-3 max-w-[40rem] text-[1.05rem] text-fg-soft">{sub}</p>}
  </div>
  {showMore && more && (
    <a
      href={more.href}
      class="group inline-flex items-center gap-2 font-bold text-accent underline decoration-2 underline-offset-[0.3em]"
    >
      {more.label}
      <Icon
        name="right"
        class="size-4 transition-transform duration-160 ease-out group-hover:translate-x-0.5"
      />
    </a>
  )}
</div>
