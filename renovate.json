{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "timezone": "Asia/Manila",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One pull request a week for every minor and patch update.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "Node.js, pnpm, Astro, and React majors are approved by hand on the Dependency Dashboard before Renovate opens a pull request.",
      "matchPackageNames": ["node", "pnpm", "astro", "react", "react-dom", "@astrojs/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "framework majors (manual review)",
      "labels": ["major"]
    },
    {
      "description": "TypeScript 7 needs typescript-eslint and @astrojs/check support first (ADR 0010).",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["major"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true
}
